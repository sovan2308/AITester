# Sample environment file. Copy to .env and fill in your own values.
#   cp .env.sample .env
# Real .env files are gitignored and must never be committed.
#
# Only scripts 008, 009 and the optional explain step in 010 need these.
# 001-007 and 010 (without the LLM notes) run with no key at all.

GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# ---- Capstone (capstone/README.md) ----------------------------------------
# Live Jira (without these, the pipeline reads capstone/fixtures/<KEY>.json)
JIRA_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token
# Tickets the 24x7 worker picks up
JQL=project = VWO AND labels = qa-auto AND labels != qa-auto-done ORDER BY created
# Email the HTML report (Gmail: use an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password
REPORT_TO=qa-team@example.com
