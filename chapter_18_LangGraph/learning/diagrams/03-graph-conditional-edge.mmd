%%{init: {"look": "handDrawn", "handDrawnSeed": 7, "themeVariables": {"fontFamily": "Helvetica Neue, Helvetica, Arial", "fontSize": "19px", "edgeLabelBackground": "#ffffff", "primaryBorderColor": "#2B2B2B", "lineColor": "#2B2B2B"}, "themeCSS": ".edgeLabel rect { opacity: 1 !important; } .edgeLabel text { font-weight: 600; }"}}%%
graph LR
  S(("START")) --> R["read_result"]
  R --> F{"route_by_status()"}
  F -->|"passed"| P["log_pass"]
  F -->|"failed"| B["file_bug"]
  F -->|"flaky"| Q["quarantine"]
  P --> E(("END"))
  B --> E
  Q --> E
  class R,P,B,Q step
  class F fork
  class S,E term
  classDef step fill:#F7D774,color:#1F2937
  classDef fork fill:#F4A3B5,color:#1F2937
  classDef bag fill:#9ED8A8,color:#1F2937
  classDef human fill:#FDBA74,color:#1F2937
  classDef llm fill:#A9B7FA,color:#1F2937
  classDef term fill:#FFFFFF,color:#1F2937
